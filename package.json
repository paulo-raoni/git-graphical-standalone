{
  "name": "git-graphical-standalone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A standalone desktop application that draws a git repository's commit graph, reimplemented clean-room from observable behaviour.",
  "license": "MIT",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "run-s build start:electron",
    "start:electron": "electron .",
    "gates": "run-s gates:format gates:lint gates:boundaries gates:types gates:build",
    "gates:format": "prettier --check .",
    "gates:lint": "eslint .",
    "gates:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "gates:types": "run-s gates:types:*",
    "gates:types:inner": "tsc --noEmit --project tsconfig.inner.json",
    "gates:types:ui": "tsc --noEmit --project tsconfig.ui.json",
    "gates:types:node": "tsc --noEmit --project tsconfig.node.json",
    "gates:build": "run-s build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "dependency-cruiser": "18.2.0",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "license-checker-rseidelsohn": "5.0.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
